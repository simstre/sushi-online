# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sushi_online?schema=public"

# Stripe keys (test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Used to build absolute URLs and resolve subdomains in production.
# In local dev, leave as localhost:3000 and visit <slug>.localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST="true"

# Bootstrap credentials created by `npm run db:seed` (change after first login).
SEED_SUPERADMIN_EMAIL="owner@sushi-online.test"
SEED_SUPERADMIN_PASSWORD="change-me"

# Vercel Blob token (production). Leave blank in local dev — uploads will
# fall back to writing to /public/uploads. This only works locally; Vercel's
# production filesystem is read-only, so a token is required for deploys.
BLOB_READ_WRITE_TOKEN=""
